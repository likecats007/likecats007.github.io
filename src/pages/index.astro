---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import PostItem from '../components/PostItem.astro';
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = [...allPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  const postTags = new Set(
    post.data.tags.map((value) => value.trim()).filter(Boolean)
  );
  for (const tag of postTags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort(
  ([tagA, countA], [tagB, countB]) =>
    countB - countA || tagA.localeCompare(tagB, 'ko')
);
---

<Layout>
  <Frame title="LATEST ENTRIES">
    <div class="menu-list">
      {posts.map((post) => <PostItem post={post} />)}
      <a class="menu-item" href="/blog/">
        <span class="mi-marker" aria-hidden="true">▪ &gt;</span>
        <span class="mi-title">VIEW FULL ARCHIVE…</span>
        <span class="mi-arrow" aria-hidden="true">›</span>
      </a>
    </div>
  </Frame>

  <hr class="home-section-divider" aria-hidden="true" />

  <Frame title="TAG INDEX">
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a class="tag-count" href={`/blog/tag/${encodeURIComponent(tag)}/`}>
          <span>#{tag}</span>
          <span class="tag-count-number">{count}</span>
        </a>
      ))}
    </div>
  </Frame>
</Layout>
