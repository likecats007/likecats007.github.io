---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Frame from '../../components/Frame.astro';
import PostItem from '../../components/PostItem.astro';
import { categorySlug, normalizeCategory } from '../../utils/category';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [
    ...new Set(allPosts.map((post) => normalizeCategory(post.data.category))),
  ];

  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      posts: allPosts
        .filter((post) => normalizeCategory(post.data.category) === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
---

<Layout title={`CATEGORY: ${category}`} description={`All posts in ${category}.`}>
  <Frame title={category}>
    <div class="menu-list">
      <div class="year-sep">FOUND {posts.length} ENTRIES</div>
      {posts.map((post) => <PostItem post={post} />)}
    </div>
  </Frame>
</Layout>
