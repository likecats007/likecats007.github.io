---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import PostItem from '../components/PostItem.astro';
import { categorySlug, normalizeCategory } from '../utils/category';

const visiblePostCount = 5;

const defaultCategories = [
  '개발',
  'CTF/Wargame',
  'Bug Bounty',
  '블로그/기술문서',
  '논문/컨퍼런스',
  '공모전/자격증',
];

const posts = (
  await getCollection('blog', ({ data }) => !data.draft)
).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [
  ...new Set([
    ...defaultCategories,
    ...posts.map((post) => normalizeCategory(post.data.category)),
  ]),
];
---

<Layout title="CATEGORIES">
  <h1>카테고리별 게시물</h1>

  {categories.map((category) => {
    const categoryPosts = posts.filter(
      (post) => normalizeCategory(post.data.category) === category
    );

    return (
      <Frame title={category}>
        <p>{categoryPosts.length}개의 게시물</p>

        <div class="menu-list">
          {categoryPosts.length > 0 ? (
            <>
              {categoryPosts.slice(0, visiblePostCount).map((post) => (
                <PostItem post={post} />
              ))}
              {categoryPosts.length > visiblePostCount && (
                <a
                  class="menu-item category-more"
                  href={`/categories/${categorySlug(category)}/`}
                  aria-label={`전체 글 보기: ${category} 카테고리`}
                >
                  <span class="mi-marker" aria-hidden="true">▪ &gt;</span>
                  <span class="mi-title">...</span>
                </a>
              )}
            </>
          ) : (
            <p>아직 게시물이 없습니다.</p>
          )}
        </div>
      </Frame>
    );
  })}
</Layout>
