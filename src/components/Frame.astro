---
// Double-bordered box with the title breaking the top line, like windows
// in old text-mode interfaces.
interface Props {
  title?: string;
  class?: string;
  id?: string;
}

const { title, class: cls, id } = Astro.props;
---

<section id={id} class:list={['frame', cls]}>
  {title && <h2 class="frame-title">{title}</h2>}
  <div class="frame-body">
    <slot />
  </div>
</section>
